# KaratWatch Configuration
# Copy to .env and fill in your values

# Server
HOST=127.0.0.1
PORT=8765

# Caching
CACHE_TTL_SECONDS=1800
RETRY_COOLDOWN_SECONDS=120
CACHE_FILE=/data/cache.json

# Request timeout
REQUEST_TIMEOUT=10.0

# Rate Limiting
RATE_LIMIT_PER_IP_PER_MINUTE=30
RATE_LIMIT_GLOBAL_PER_MINUTE=120

# Authentication: local API key; behind Access, send all three headers.
# Option 1: API Key (set X-Metals-Api-Key header)
API_KEY=your-secure-random-api-key-here

# Cloudflare Access Service Token (set CF-Access-Client-Id and CF-Access-Client-Secret headers)
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# Provider Configuration
METALS_PROVIDERS=goodreturns
METALS_PROVIDER_TIMEOUT=10.0
METALS_PROVIDER_RETRY_COOLDOWN=120
METALS_PROVIDER_MAX_FAILURES=3

# Goodreturns URLs
GOODRETURNS_GOLD_URL=https://www.goodreturns.in/gold-rates/ahmedabad.html
GOODRETURNS_SILVER_URL=https://www.goodreturns.in/silver-rates/ahmedabad.html

# Future providers (not enabled yet):
# METALS_PROVIDERS=goodreturns,provider2,provider3
# PROVIDER2_TIMEOUT=10.0
# PROVIDER2_CUSTOM_CONFIG={"key": "value"}